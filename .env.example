# Example environment variables
# Sentinel Open Access Hub (Copernicus) credentials
SENTINEL_USER=your_copernicus_username
SENTINEL_PASSWORD=your_copernicus_password
SENTINEL_API_URL=https://scihub.copernicus.eu/dhus

# Add other provider credentials as you integrate:
# USGS_USER=...
# NASA_EARTHDATA_USER=...
# NASA_EARTHDATA_PASSWORD=...
# NOAA_TOKEN=...
